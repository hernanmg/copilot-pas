# Copilot-Seguros (backend) - ejemplo de variables de entorno
# Copiá este archivo como ".env" o ".env.local" y completá valores.

# Embeddings provider
# - OPENAI: requiere billing/cuota en OpenAI
# - OLLAMA: embeddings locales (sin cuota)
RAG_EMBEDDINGS_PROVIDER=OPENAI

# OpenAI (solo si RAG_EMBEDDINGS_PROVIDER=OPENAI)
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536

# Ollama (solo si RAG_EMBEDDINGS_PROVIDER=OLLAMA)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large
RAG_EMBEDDING_DIMENSIONS=1024

# Backend
PORT=4000

# Postgres (si corrés DB en Docker)
DB_HOST=localhost
DB_PORT=5433
DB_USER=copilot
DB_PASSWORD=copilot_pass
DB_NAME=copilot_seguros

# Redis (si corrés Redis en Docker)
REDIS_HOST=localhost
REDIS_PORT=6380

